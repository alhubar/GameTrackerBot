# Discord Game Tracker configuration.
#
# Copy this file to .env and edit it. Only DISCORD_TOKEN is required — every other value below is
# shown at its default, so a line you delete behaves the same as the line you found here.
#
# Settings are grouped by feature and the groups are numbered; keep new ones in their group rather
# than appended at the end. Everything here is global to the process: one instance serving several
# guilds gives them all the same ranks, thresholds and channel names.
#
# Channel settings hold channel NAMES, not IDs. Renaming a channel in Discord silently stops the
# matching announcements — the lookup just returns nothing and the message is skipped.


# ==============================================================================
# 1. Discord connection                                              (required)
# ==============================================================================

# Create this bot token at https://discord.com/developers/applications
# The bot also needs the Presence Intent and Server Members Intent enabled under
# Bot -> Privileged Gateway Intents, or it cannot see anyone playing anything.
DISCORD_TOKEN=put-your-bot-token-here

# Optional: restricts the bot to a single server. Commands are always registered per-guild (so they
# update instantly either way); setting this only stops other guilds the bot is in from getting them.
# Note that ranks, thresholds, channel names and recap settings below are global to the process, so
# running one instance across several servers gives them all the same configuration.
GUILD_ID=


# ==============================================================================
# 2. Storage
# ==============================================================================

# Where the SQLite database lives. Defaults to data/tracker.sqlite. Point this at a throwaway file
# when trying the bot against a test server so real stats are never touched.
DATABASE_PATH=

# Nightly backups. Set false to turn them off entirely; /backup still works on demand.
BACKUP_ENABLED=true

# Where the copies go. Created if missing. Put this on a different disk than DATABASE_PATH if you
# can — a backup beside the original does not survive losing the drive.
BACKUP_DIR=data/backups

# How many nightly copies to keep. The oldest are deleted once there are more than this.
BACKUP_KEEP=7

# Hour of the day (0-23, UTC) the nightly copy is taken. UTC so it lands at the same real moment
# wherever the host is, and so a daylight-saving change cannot skip or duplicate a night.
BACKUP_HOUR_UTC=4


# ==============================================================================
# 3. Ranks and level-ups
# ==============================================================================

# Comma-separated rank names. Keep the names and hour values in the same order.
#
# Adding a rank to the END is safe. INSERTING one anywhere else — including at the start, to give
# everybody a starting rank — is not, unless you clear the saved mapping first. /setup pairs each
# rank with its role by *position in this list*, so inserting one shifts every rank after it and
# renames the whole ladder down a rung: the role your top members are wearing keeps its id and
# quietly becomes the name of the rank below, and a brand-new role is created for the last name.
# Members are demoted without a single role being added or removed.
#
# To insert a rank safely: stop the bot, delete the rank_roles rows for the guild
# (sqlite3 data/tracker.sqlite "DELETE FROM rank_roles WHERE guild_id = '...'"), then start it and
# run /setup. With no saved mapping, each name is matched to the existing role of the same name and
# only the genuinely new one is created.
RANK_NAMES=Villager,Pathfinder,Dungeon Delver,Dragon Slayer,Realm Guardian,Mythic Hero,Eternal Legend

# A role for members who have not reached the first rank yet — a name for "unranked" rather than a
# rank of its own. Blank leaves them with no role at all, which is the default. It is created on
# first use in Discord's own default grey, unhoisted position aside, and sits beneath every rank.
#
# Deliberately NOT an entry in RANK_NAMES above, for two reasons. Putting it there would make it
# rank 0 at zero hours, and then nobody is ever unranked — which silently removes the guard on the
# achievements that ask whether a member was ever established, letting them fire for somebody who
# has never played a minute. It would also shift every rank index and rename the ladder, as the
# warning above describes. Kept outside the ladder it changes nothing any stat can see: these
# members are still unranked everywhere it counts, and still sort exactly where they did.
UNRANKED_ROLE=

# Total hours needed to reach each matching rank. Players receive no rank
# before the first value; each following value must be larger than the previous value.
# The values here are placeholders, not a recommendation — set your own in .env.
RANK_HOURS=1,2,3,4,5,6,7

# Text channel name for rank-up announcements. Leave blank to keep posting wherever /setup was last
# run, which is where they went before this setting existed.
LEVEL_UP_CHANNEL=

# Optional custom level-up messages, one per rank — LEVEL_UP_MESSAGE_1 is the first rank in
# RANK_NAMES. Add or remove lines to match how many ranks you have defined.
# Available placeholders: {user}, {level}, {rank}, {hours}.
LEVEL_UP_MESSAGE_1=🎮 {user} has become **Level {level} — {rank}** after **{hours}** of playtime!
LEVEL_UP_MESSAGE_2=🎮 {user} has become **Level {level} — {rank}** after **{hours}** of playtime!
LEVEL_UP_MESSAGE_3=🎮 {user} has become **Level {level} — {rank}** after **{hours}** of playtime!
LEVEL_UP_MESSAGE_4=🎮 {user} has become **Level {level} — {rank}** after **{hours}** of playtime!
LEVEL_UP_MESSAGE_5=🎮 {user} has become **Level {level} — {rank}** after **{hours}** of playtime!
LEVEL_UP_MESSAGE_6=🎮 {user} has become **Level {level} — {rank}** after **{hours}** of playtime!
LEVEL_UP_MESSAGE_7=🎮 {user} has become **Level {level} — {rank}** after **{hours}** of playtime!


# ==============================================================================
# 4. Playtime tracking
# ==============================================================================

# Discord marks a member idle after about ten minutes without input but keeps reporting whatever
# game is still open, so an unattended launcher would bank a full night of playtime. With this on,
# the clock stops while a member is idle and restarts when they come back; the idle stretch is never
# credited and never counts toward session-length achievements. Set false to count idle time as play.
PAUSE_ON_IDLE=true

# Backstop for when idle never fires (a mouse jiggler, or a client that just never reports it): any
# session running past this many hours of *active* time is closed. Anyone genuinely still playing is
# picked up again on their next presence change. Keep it above your longest session-length
# achievement or that one stops being reachable. Set 0 to disable the cap entirely.
MAX_SESSION_HOURS=12


# ==============================================================================
# 5. Achievements
# ==============================================================================

# Achievement unlock announcements (personal and server-wide). Set to false to stop posting them
# (achievements still unlock silently). Both kinds post to the same channel.
ACHIEVEMENT_ANNOUNCEMENTS=true

# Text channel name where achievement unlocks are posted. Required for announcements; leave blank to disable.
ACHIEVEMENT_CHANNEL=achievements


# ==============================================================================
# 6. Server achievement thresholds
# ==============================================================================

# Server-wide achievement thresholds, comma-separated and increasing. Tune these to your server's
# size — a large server may want higher numbers so early tiers don't all unlock in the first day,
# and a small server may want lower ones so later tiers are reachable at all.
# The number of values is the number of tiers: two values means two tiers.
SERVER_PLAYER_THRESHOLDS=5,10,25,50

# Only games the server has put at least an hour into count here, so a game someone launched once
# and closed does not pad the library.
SERVER_GAME_THRESHOLDS=10,25,50,100

SERVER_PLAYTIME_HOURS=100,500,1000,5000,10000

SERVER_DOMINANCE_HOURS=100,500,1000,2500

# Members count toward this only once they have an hour in that game themselves.
SERVER_DOMINANCE_PLAYERS=10,20

# 3+ different games being played on the server at the same time.
SERVER_MELTING_POT_THRESHOLD=3

# How many members must simultaneously hold the highest rank at once.
# How long that takes depends entirely on your RANK_HOURS — tune the two together.
SERVER_TOP_RANK_THRESHOLDS=3

# Different games started on the server in a single day.
SERVER_RUSH_HOUR_THRESHOLDS=8

# Consecutive days with at least one member playing something, any member counts each day.
SERVER_ALWAYS_ON_THRESHOLDS=14

# Combined personal-achievement unlocks across every member. Two thresholds here means two tiers.
SERVER_TROPHY_CASE_THRESHOLDS=50,150

# Different member pairs who have each played together on 5+ different days. Two thresholds, two tiers.
SERVER_SQUAD_BONDS_THRESHOLDS=3,6

# One member at every rank tier at once has no threshold to set — it always requires exactly as
# many rank tiers as RANK_NAMES/RANK_HOURS define.


# ==============================================================================
# 7. Gamer of the Week / Month recap
# ==============================================================================

# Gamer of the Week/Month. On the first hourly check after the period ends, the bot posts a recap:
# who played the most, their most-played game, and the achievements they earned. Set false to disable.
RECAP_ENABLED=true

# "week" (Monday to Sunday, UTC) or "month". Weekly keeps the winner's badge circulating between
# members instead of parking on one person for four weeks.
# Both periods are measured in UTC, so a Sunday evening in a western timezone already belongs to the
# next week. That is deliberate — it keeps every member's week identical regardless of where they are.
RECAP_PERIOD=week

# Text channel name for the recap. Leave blank to reuse ACHIEVEMENT_CHANNEL.
RECAP_CHANNEL=

# Hours of tracked play the top member must reach before the title is awarded at all. Below this
# the bot posts a "nobody was worthy" card instead and the badge is taken off whoever held it, so
# a quiet week leaves the title vacant rather than crowning someone for a few idle minutes.
# Set to 0 to award it to anyone with any tracked play.
RECAP_MIN_HOURS=2

# Role handed to the winner and worn until the next recap, when it moves to the new winner. The bot
# creates it on first use (gold, shown separately in the member list) and positions it just below
# its own role so the colour is not overridden by the rank roles. Needs Manage Roles, with the bot's
# own role above it. Leave blank to post the recap without handing out any role.
RECAP_WINNER_ROLE=Champion of the Realm

# Optional emoji shown as the role's icon beside the winner's name. Discord only allows role icons
# from Server Boost Level 2; below that the bot logs a note and the badge works without one, so it
# is safe to set now and it starts showing if the server is ever boosted.
RECAP_WINNER_ROLE_ICON=


# ==============================================================================
# 8. Social badges
# ==============================================================================

# Weekly badges for the members who turn up to talk rather than play, awarded in the same recap
# post as Gamer of the Week. Activity is measured in *minutes a member was active*, never in
# messages sent — a message count would simply reward whoever posts most often.
#
# The bot never reads what anybody writes. Counting who posted needs only the non-privileged
# GuildMessages intent; MessageContent is the privileged one and is never requested.
#
# Set false to switch the whole feature off: the event handlers are not registered at all, so
# nothing is recorded and no badge is awarded. Existing rows are left alone, so turning it back on
# picks up where it left off. Members who have used /privacy optout are excluded either way.
SOCIAL_ENABLED=true

# Voice time only counts while a member is unmuted, undeafened, and has at least one other person
# in the channel with them — so sitting alone in a call, or idling muted, is worth nothing. Bots
# do not count as company, and the server's AFK channel never counts at all.
#
# This is the ceiling on how much voice time one member can bank in a single day. The rules above
# cannot tell two friends talking from two friends who both left the call connected overnight, and
# this bounds how far that can go. Raise it if your people genuinely hold long calls.
SOCIAL_VOICE_DAILY_CAP_MINUTES=240

# The two badges, awarded in the same recap post as Gamer of the Week. Blank either name to switch
# that badge off without affecting the other; minutes keep being recorded either way, so turning a
# name back on starts awarding again from real history.
#
# Nobody ever holds two badges. If the same member tops the playtime board and a talking board,
# the badge passes to the next person down and the recap says who really led it — the point is that
# something changes hands every week, not that one member collects the set. Gamer of the Week
# always has first claim.
BARD_ROLE=Bard
SCRIBE_ROLE=Scribe

# Optional emoji shown as each role's icon, exactly like RECAP_WINNER_ROLE_ICON above: Discord only
# allows role icons from Server Boost Level 2, and below that the badge simply works without one.
BARD_ROLE_ICON=
SCRIBE_ROLE_ICON=

# The minimum needed to take each badge at all. These are NOT the same scale and should not be set
# to the same number: an hour in voice is one ordinary call, while an hour of *active typing
# minutes* — separate minutes in which you sent at least one message — is a very heavy week.
#
# If nobody clears the bar the badge is announced as unclaimed rather than handed to whoever
# happened to say the most, and the pass-down to a runner-up stops here too. Set 0 for no minimum.
BARD_MIN_MINUTES=60
SCRIBE_MIN_MINUTES=30

# Cave Dweller: a badge for members who did nothing at all last period — no messages, no voice, no
# games. OFF unless you set this to true, and the only setting in this file that defaults to off.
#
# Think before switching it on. By its own definition it only reaches people who were not there,
# so it rewards nobody and is seen by almost nobody, while being the one badge here that can land
# badly. It is unhoisted for the same reason: it colours a name without carving a public
# "inactive" section into the member list.
#
# It cannot collide with the other badges — playing, talking or typing all disqualify you from it —
# and it comes off the instant a member does any of those, not at the next recap. Switching this
# back to false leaves any existing roles alone rather than firing a burst of edits; delete the
# role in Discord to clear it.
CAVE_DWELLER_ENABLED=false
CAVE_DWELLER_ROLE=Cave Dweller
CAVE_DWELLER_ROLE_ICON=

# How long a member must have been in the server, and tracked by the bot, BEFORE a period begins to
# be judged on it. Somebody who joined on the Friday has no record for that week and has earned no
# joke; nor has anybody at all if the bot itself was only switched on mid-week.
CAVE_DWELLER_GRACE_DAYS=14


# ==============================================================================
# 9. Events and game nights
# ==============================================================================

# /event create asks which timezone the event is in before showing the form. Set this to whichever
# zones your own members actually live in. Comma-separated IANA zone names, up to 25 (Discord's
# select menu limit) — the dropdown label is taken from the zone name itself, so Europe/Lisbon shows
# as "Lisbon" and America/Los_Angeles as "Los Angeles". The time you type is converted once using
# the zone you pick; Discord then displays it to each viewer in their own local time automatically
# via native timestamp formatting. Defaults to UTC, New York, Berlin, and Tokyo if unset.
EVENT_TIMEZONE_PRESETS=UTC,America/New_York,Europe/Berlin,Asia/Tokyo

# Comma-separated minutes-before-start values; the "Going" list gets pinged once at each stage.
# 0 means "at start" ("is starting now!" instead of "starts in X"). Default is 12 hours, 1 hour,
# and at start. Editing an event's time resets which stages have fired.
EVENT_REMINDER_STAGES_MINUTES=720,60,0


# ==============================================================================
# 10. Release announcements
# ==============================================================================

# Release announcements. /changes fetches the latest published GitHub Release.
CHANGES_CHANNEL=game-updates

# The repository /changes reads release notes from, in owner/repository form.
GITHUB_REPOSITORY=your-github-user/your-repository

# Optional: needed only when the repository is private or GitHub rate-limits anonymous requests.
GITHUB_TOKEN=


# ==============================================================================
# 11. Diagnostics
# ==============================================================================

# Error lines normally refer to members by a short stable hash instead of a username or ID, so that
# pasting a stack trace into an issue or a chat does not publish who it was about. Set true to log
# real IDs while debugging something member-specific, and turn it back off afterwards.
DEBUG_IDENTIFIERS=false
